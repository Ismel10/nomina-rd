# Copiar a .env y completar. NUNCA commitear .env ni poner valores reales aquí.

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO
# Generar uno propio, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=nomina
POSTGRES_PASSWORD=
POSTGRES_DB=nomina
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nomina:<password>@localhost:5432/nomina
TEST_DATABASE_URL=postgresql+psycopg://nomina:<password>@localhost:5432/nomina_test

# --- País / configuración regional ---
PAYROLL_COUNTRY=DO
DEFAULT_CURRENCY=DOP
DEFAULT_LOCALE=es-DO
TIMEZONE=America/Santo_Domingo
# Redondeo de montos por línea de concepto (ver AGENTS.md §3). TODO(verificar-normativa)
MONEY_ROUNDING=ROUND_HALF_UP

# --- Frontend (Vite expone solo variables con prefijo VITE_) ---
VITE_API_BASE_URL=http://localhost:8000
